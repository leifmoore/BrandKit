    "sidebar-primary-foreground": { "type": "color", "light": "#ffffff", "dark": "oklch(0.278 0.033 256.848)", "role": "Content on sidebar primary" },
    "sidebar-accent": { "type": "color", "light": "oklch(0.278 0.033 256.848 / 5%)", "dark": "oklch(1 0 0 / 7%)", "role": "Sidebar hover wash" },
