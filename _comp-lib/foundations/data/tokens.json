    "font-weight-medium": { "type": "fontWeight", "light": "500", "dark": "500", "role": "Headings, labels and controls" },
    "background": { "type": "color", "light": "#ffffff", "dark": "oklch(0.278 0.033 256.848)", "role": "Application canvas" },
