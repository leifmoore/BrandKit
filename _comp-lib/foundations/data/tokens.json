    "status-danger-foreground": { "type": "color", "light": "oklch(0.444 0.177 26.899)", "dark": "oklch(0.808 0.114 19.571)", "role": "Danger text on tinted surfaces" },
    "info": { "type": "color", "light": "oklch(0.546 0.245 262.881)", "dark": "oklch(0.707 0.165 254.624)", "role": "Informational accent" },
    "info-foreground": { "type": "color", "light": "oklch(0.424 0.199 265.638)", "dark": "oklch(0.809 0.105 251.813)", "role": "Information text on tinted surfaces" }
