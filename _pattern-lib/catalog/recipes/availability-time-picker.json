    "callbacks": [{ "name": "onLocationChange", "type": "(locationId: string) => void", "required": true }, { "name": "onPricingModeChange", "type": "(modeId: string) => void", "required": false }, { "name": "onTimeChange", "type": "(timeId: string | null, bandId: string) => void", "required": true }]
