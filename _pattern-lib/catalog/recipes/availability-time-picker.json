  "responsiveBehavior": ["Time bands retain the approved three-column layout at all documented viewport widths.", "Exact times use four compact columns and wrap within the available width.", "Location chips wrap without horizontal clipping."],
  "accessibility": { "status": "passed-with-findings", "findings": ["The 12px discounted-price text using --epos-accent measures 3.66:1 in light mode and 4.01:1 in dark mode, below WCAG AA 4.5:1. The approved colour is retained for visual parity; the original-and-discounted price treatment ensures discount meaning is not conveyed by colour alone."] },
