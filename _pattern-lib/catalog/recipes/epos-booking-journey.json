      { "name": "review", "type": "BookingReviewSummaryProps", "required": true },
      { "name": "checkout", "type": "CheckoutDetailsPanelProps", "required": true }
    ],
    "callbacks": [
      { "name": "onComplete", "type": "() => void", "required": false, "description": "Receives the preview completion action; the host performs persistence." }
    ]
  },
  "dependencies": {
    "internal": [
      "availability-time-picker",
