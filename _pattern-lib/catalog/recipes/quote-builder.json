    "callbacks": [{ "name": "onSubmit", "type": "(draft: QuoteDraft) => void | Promise<void>", "required": true }]
  },
  "dependencies": { "internal": ["button", "checkbox", "dialog", "input", "label"], "npm": ["lucide-react@0.487.0"], "bladeRuntime": ["Alpine.js 3", "Alpine Focus", "Phosphor Icons"] },
  "responsiveBehavior": ["Recipient fields stack at 360px and become two columns at the small breakpoint.", "Time-band options follow the same one-to-two-column transition.", "Expiry chips wrap without clipping."],
  "accessibility": { "status": "passed-with-findings", "findings": ["The host owns pending-state and server-validation announcements and must focus the first invalid field. Blade dialog focus trapping and return must be verified after Alpine integration."] },
