{
  "name": "scudamores-brand-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:a11y": "playwright test tests/developer.a11y.spec.ts",
    "test:visual": "playwright test tests/developer.visual.spec.ts",
    "audit:brand:visual": "playwright test --config playwright.brand-audit.config.ts",
    "generate:brand-images": "node scripts/generate-brand-images.mjs",
    "verify:handoff": "node scripts/verify-handoff.mjs && node _comp-lib/foundations/scripts/generate-css.mjs && node _comp-lib/validation/scripts/validate-recipes.mjs",
    "verify:canonical": "node scripts/verify-canonical-copies.mjs",
    "verify:foundation": "npm run verify:handoff && npm run build",
    "verify:developer": "node scripts/verify-developer.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.2.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-router-dom": "6.30.4",
    "recharts": "3.8.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
